// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String   @id @default(uuid()) // Se vincula manual con supabase auth.users
  email                   String   @unique
  name                    String
  avatarUrl               String?
  defaultCurrency         String   @default("MXN")
  timezone                String?  // Zona horaria preferida (ej: "America/Mexico_City"). Null = usar navegador o inferir de moneda
  preferredLocale         String   @default("es-MX")
  theme                   String   @default("system")
  notificationPreferences Json?    // Preferencias de notificaciones (NotificationPreferences)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  wallets           Wallet[]
  transactions      Transaction[]
  categories        Category[]
  budgets           Budget[]
  tags              Tag[]
  goals             Goal[]
  subscriptions     Subscription[]
  debts             Debt[]
  pushSubscriptions PushSubscription[]
}

model Wallet {
  id          String   @id @default(uuid())
  userId      String
  name        String
  type        String // 'cash' | 'bank' | 'credit' | 'loan' | 'ewallet' | 'crypto' | 'investment'
  currency    String
  balance     Float    @default(0)
  creditLimit Float?
  monthlyPayment Float?
  paymentDueDay Int?
  icon        String
  color       String
  isArchived         Boolean   @default(false)
  sortOrder          Int       @default(0)
  interestEnabled    Boolean   @default(false)
  interestRate       Float?
  interestStartDate  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]  @relation("WalletTransactions")
  transfersIn   Transaction[]  @relation("TransferToWallet")
  goals         Goal[]
  subscriptions Subscription[]
}

model Category {
  id        String  @id @default(uuid())
  userId    String? // Nulo si es categoría global/por defecto
  parentId  String?
  name      String
  icon      String
  color     String
  type      String // 'income' | 'expense'
  isDefault Boolean @default(false)

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  subscriptions Subscription[]
  parent        Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children      Category[]     @relation("CategoryHierarchy")
}

model Transaction {
  id                 String    @id @default(uuid())
  walletId           String?
  debtId             String?   // Para transacciones desde tarjetas de crédito/deudas
  userId             String
  type               String // 'income' | 'expense' | 'transfer'
  amount             Float
  currency           String
  categoryId         String
  description        String
  note               String?
  date               DateTime  @db.Date
  isRecurring        Boolean   @default(false)
  // Campos de recurrencia en json o columnas, simplicado por ahora
  recurringFrequency String? // 'daily' | 'weekly' | 'monthly' | 'yearly'
  recurringInterval  Int?
  recurringEndDate   DateTime? @db.Date
  transferToWalletId String?
  transferToDebtId   String?   // Para transferencias hacia deudas (pagos)
  externalRecipient  String?   // Para transferencias a terceros (nombre libre del destinatario)
  walletName         String?   // Nombre de la cuenta origen, preservado si la wallet se elimina
  transferToWalletName String? // Nombre de la cuenta destino, preservado si la wallet destino se elimina
  msiMonths          Int?      // Meses sin intereses de una compra con tarjeta (null o 1 = pago único)
  debtEffect         String?   // 'charge' | 'payment' - efecto sobre la deuda
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SetNull: al borrar una wallet, las transacciones NO se eliminan; su walletId queda null
  // y el nombre se conserva en walletName/transferToWalletName (ver walletService.deleteWallet).
  wallet           Wallet?  @relation("WalletTransactions", fields: [walletId], references: [id], onDelete: SetNull)
  debt             Debt?    @relation("DebtTransactions", fields: [debtId], references: [id], onDelete: Cascade)
  transferToWallet Wallet?  @relation("TransferToWallet", fields: [transferToWalletId], references: [id], onDelete: SetNull)
  transferToDebt   Debt?    @relation("TransferToDebt", fields: [transferToDebtId], references: [id])
  category         Category @relation(fields: [categoryId], references: [id])
  tags             Tag[]    @relation("TransactionTags")
}

model Tag {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[] @relation("TransactionTags")
}

model Budget {
  id              String    @id @default(uuid())
  userId          String
  walletIds       String[]
  name            String
  amount          Float
  spent           Float     @default(0)
  period          String // 'weekly' | 'biweekly' | 'monthly' | 'yearly'
  categoryIds     String[]
  startDate       DateTime  @db.Date
  endDate         DateTime? @db.Date
  rollover        Boolean   @default(false)
  trackHistorical Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id            String    @id @default(uuid())
  userId        String
  name          String
  type          String // 'savings' | 'debt_payoff' | 'emergency' | 'custom'
  targetAmount  Float
  currentAmount Float     @default(0)
  deadline      DateTime? @db.Date
  icon          String
  color         String
  walletId      String?
  isCompleted   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)
}

model Subscription {
  id             String   @id @default(uuid())
  userId         String
  name           String
  amount         Float
  currency       String
  billingCycle   String // 'weekly' | 'monthly' | 'yearly'
  categoryId     String
  nextBillDate   DateTime @db.Date
  icon           String
  platformId     String?
  color          String
  isActive       Boolean  @default(true)
  isDomiciliado  Boolean  @default(false)
  walletId       String?
  debtId         String?  // Para suscripciones pagadas con tarjeta de crédito/deuda
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])
  wallet   Wallet?  @relation(fields: [walletId], references: [id], onDelete: SetNull)
  debt     Debt?    @relation(fields: [debtId], references: [id], onDelete: SetNull)
}

model Debt {
  id              String    @id @default(uuid())
  userId          String
  name            String
  type            String // 'personal_credit' | 'credit_card' | 'personal_loan' | 'department_store' | 'mortgage' | 'car_loan' | 'other'
  currency        String
  originalAmount  Float
  currentBalance  Float
  interestRate    Float?
  minimumPayment  Float?
  statementDay      Int?      // Día de corte del estado de cuenta (1-31)
  paymentDueDay     Int?      // Día límite de pago (1-31)
  paymentDueMonthOffset Int   @default(0) // Meses después del corte que vence el pago (0=mismo mes, 1=mes siguiente, 2=dos meses)
  monthlyPaymentEnabled Boolean @default(false) // Si true, el pago mínimo se trata como mensualidad por ciclo (baja con abonos del mes y se reinicia). Útil para préstamos.
  statementPaidUntil DateTime? // Fecha de corte hasta la cual el ciclo cerrado ya fue marcado como pagado
  accruedNextCycleOverride Float? // Ajuste base del acumulado próximo corte
  accruedOverrideDate      DateTime? // Fecha en que se configuró el ajuste (solo sumar compras posteriores)
  nextPaymentDate DateTime? // Próxima fecha límite de pago (con hora para evitar desfase UTC)
  startDate       DateTime
  endDate         DateTime?
  icon            String
  color           String
  isActive        Boolean   @default(true)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Relaciones inversas para transacciones
  transactions  Transaction[]  @relation("DebtTransactions")
  transfersIn   Transaction[]  @relation("TransferToDebt")
  subscriptions Subscription[]
}

model Currency {
  code String @id
  name String
  flag String
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
