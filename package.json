{
  "name": "Cashcore",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^12.0.0"
  },
  "packageManager": "pnpm@12.14.0",
  "volta": {
    "node": "24.20.0",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "clean": "rimraf .next node_modules package-lock.json pnpm-lock.yaml",
    "preinstall": "pnpm dlx only-allow pnpm && node -e \"try{require('child_process').execSync('volta --version',{stdio:'ignore'})}catch(e){console.warn('\\n[aviso] Volta no esta instalado. Para usar la version de Node/pnpm fijada en este proyecto instala Volta una vez: https://volta.sh  (en Windows: winget install Volta.Volta). Sin Volta debes tener Node 24.x y pnpm 12.x manualmente.\\n')}\"",
    "postinstall": "prisma generate",
    "db:push": "prisma generate && prisma db push",
    "restart": "pnpm run clean && pnpm install && pnpm run dev"
  },
  "prisma": {
    "seed": "pnpm exec tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "date-fns": "^4",
    "framer-motion": "^12",
    "lucide-react": "^0.469",
    "next": "16.2.3",
    "next-themes": "^0.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7",
    "recharts": "^2",
    "sonner": "^2",
    "tailwind-merge": "^3",
    "zod": "^3",
    "zustand": "^5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "prisma": "^6.19.3",
    "rimraf": "^6.1.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
