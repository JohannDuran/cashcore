# Instalaciones reproducibles e identicas entre maquinas
engine-strict=true      # falla el install si Node/pnpm no cumplen "engines"
save-exact=true         # fija versiones exactas al agregar dependencias
frozen-lockfile=true    # prohibe instalar algo distinto al pnpm-lock.yaml

# El bloqueo de npm/yarn se hace en el script "preinstall" del package.json
# (pnpm dlx only-allow pnpm), no desde este archivo.

# NOTA: NO usar shamefully-hoist. Se removio deliberadamente: el build pasa con
# la resolucion estricta de pnpm (sin aplanar node_modules), lo que evita
# "phantom dependencies". Reactivarlo solo si una dependencia concreta lo exige.
